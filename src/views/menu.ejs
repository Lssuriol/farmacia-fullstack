<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Farmacia - Menú Principal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background-color: #f8f0f5; }
    .navbar-custom { background-color: #d63384; }
    .card-custom { border: 1px solid #f1d2e1; }
    .btn-pink { background-color: #d63384; color: white; }
    .btn-pink:hover { background-color: #e83e8c; color: white; }
  </style>
</head>
<body>

  <nav class="navbar navbar-expand-lg navbar-dark navbar-custom shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="#">Farmacia FullStack</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <div class="navbar-nav me-auto" id="navDynamicOptions"></div>
        <div class="d-flex flex-column flex-lg-row align-items-lg-center mt-2 mt-lg-0">
          <span class="text-white me-lg-3 mb-2 mb-lg-0" id="userInfo"></span>
          <button class="btn btn-sm btn-outline-light" onclick="cerrarSesion()">Cerrar Sesión</button>
        </div>
      </div>
    </div>
  </nav>

  <div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 class="fw-bold mb-0" style="color: #d63384;">Catálogo de Medicamentos por TipoMedic</h2>
      <button id="btnAgregar" class="btn btn-pink fw-bold d-none" onclick="abrirModalCrear()">+ Nuevo Medicamento</button>
    </div>

    <div class="row">
      <% if (tiposMedic && tiposMedic.length > 0) { %>
        <% tiposMedic.forEach(tipo => { %>
          <div class="col-12 mb-4">
            <div class="card card-custom shadow-sm">
              <div class="card-header bg-white border-0 pt-3">
                <h4 class="fw-bold mb-0" style="color: #d63384;"><%= tipo.descripcion %></h4>
              </div>
              <div class="card-body">
                <div class="row">
                  <% if (tipo.medicamentos && tipo.medicamentos.length > 0) { %>
                    <% tipo.medicamentos.forEach(med => { %>
                      <div class="col-md-6 col-lg-4 mb-3" id="med-card-<%= med.CodMedicamento %>">
                        <div class="p-3 border rounded bg-light h-100 d-flex flex-column justify-content-between">
                          <div>
                            <span class="badge bg-secondary mb-1"><%= med.Marca %></span>
                            <h6 class="fw-bold text-dark"><%= med.descripcionMed %></h6>
                            <p class="small text-muted mb-1">Presentación: <%= med.Presentacion %></p>
                            <p class="small text-muted mb-2">Vence: <%= med.fechaVencimiento %></p>
                          </div>
                          <div>
                            <div class="d-flex justify-content-between align-items-center my-2">
                              <span class="fw-bold" style="color: #d63384;">S/ <%= Number(med.precioVentaUni).toFixed(2) %></span>
                              <span class="badge bg-primary">Stock: <%= med.stock %></span>
                            </div>
                            <div class="action-buttons d-none mt-2 d-flex gap-2">
                              <button class="btn btn-warning btn-sm w-50 fw-bold" onclick="abrirModalEditar('<%= JSON.stringify(med) %>')">Editar</button>
                              <button class="btn btn-danger btn-sm w-50 fw-bold" onclick="eliminarMedicamento('<%= med.CodMedicamento %>')">Eliminar</button>
                            </div>
                          </div>
                        </div>
                      </div>
                    <% }) %>
                  <% } else { %>
                    <p class="text-muted small ms-3">Sin medicamentos asignados.</p>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <!-- Modal para Crear / Editar Medicamento -->
  <div class="modal fade" id="modalMedicamento" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title fw-bold" id="modalTitulo" style="color: #d63384;">Medicamento</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <form id="formMedicamento" onsubmit="guardarMedicamento(event)">
            <input type="hidden" id="medId">
            <div class="mb-3">
              <label class="form-label">Descripción / Nombre</label>
              <input type="text" id="descripcionMed" class="form-control" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Marca</label>
              <input type="text" id="Marca" class="form-control" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Presentación</label>
              <input type="text" id="Presentacion" class="form-control" required>
            </div>
            <div class="row">
              <div class="col-6 mb-3">
                <label class="form-label">Precio Unitario</label>
                <input type="number" step="0.01" id="precioVentaUni" class="form-control" required>
              </div>
              <div class="col-6 mb-3">
                <label class="form-label">Stock</label>
                <input type="number" id="stock" class="form-control" required>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label">TipoMedic (ID)</label>
              <input type="number" id="CodTipoMed" class="form-control" value="1" required>
            </div>
            <button type="submit" class="btn btn-pink w-100 fw-bold">Guardar Cambios</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const userRaw = localStorage.getItem('usuario');
    let modalBs;

    document.addEventListener('DOMContentLoaded', () => {
      modalBs = new bootstrap.Modal(document.getElementById('modalMedicamento'));
    });

    if (!userRaw) {
      window.location.href = '/login';
    } else {
      const user = JSON.parse(userRaw);
      document.getElementById('userInfo').textContent = `${user.nombre} (${user.rol.toUpperCase()})`;

      const nav = document.getElementById('navDynamicOptions');
      let links = `<a class="nav-link active" href="/menu">Ver Catálogo</a>`;

      if (user.rol === 'administrador') {
        links += `<a class="nav-link text-white fw-semibold" href="#">[Admin] Gestionar Usuarios</a>`;
        document.getElementById('btnAgregar').classList.remove('d-none');
      }
      nav.innerHTML = links;

      if (user.rol === 'administrador' || user.rol === 'moderador') {
        document.querySelectorAll('.action-buttons').forEach(el => el.classList.remove('d-none'));
      }
    }

    function abrirModalCrear() {
      document.getElementById('formMedicamento').reset();
      document.getElementById('medId').value = '';
      document.getElementById('modalTitulo').textContent = 'Crear Medicamento';
      modalBs.show();
    }

    function abrirModalEditar(jsonStr) {
      const med = JSON.parse(jsonStr);
      document.getElementById('medId').value = med.CodMedicamento;
      document.getElementById('descripcionMed').value = med.descripcionMed;
      document.getElementById('Marca').value = med.Marca;
      document.getElementById('Presentacion').value = med.Presentacion;
      document.getElementById('precioVentaUni').value = med.precioVentaUni;
      document.getElementById('stock').value = med.stock;
      document.getElementById('CodTipoMed').value = med.CodTipoMed;
      document.getElementById('modalTitulo').textContent = 'Editar Medicamento';
      modalBs.show();
    }

    async function guardarMedicamento(e) {
      e.preventDefault();
      const id = document.getElementById('medId').value;
      const bodyData = {
        descripcionMed: document.getElementById('descripcionMed').value,
        Marca: document.getElementById('Marca').value,
        Presentacion: document.getElementById('Presentacion').value,
        precioVentaUni: document.getElementById('precioVentaUni').value,
        stock: document.getElementById('stock').value,
        CodTipoMed: document.getElementById('CodTipoMed').value
      };

      const url = id ? `/api/medicamentos/${id}` : '/api/medicamentos';
      const method = id ? 'PUT' : 'POST';

      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(bodyData)
      });

      if (res.ok) {
        location.reload();
      } else {
        alert('Error al guardar el medicamento');
      }
    }

    async function eliminarMedicamento(id) {
      if (confirm('¿Deseas eliminar este medicamento?')) {
        const res = await fetch(`/api/medicamentos/${id}`, { method: 'DELETE' });
        if (res.ok) location.reload();
      }
    }

    function cerrarSesion() {
      localStorage.clear();
      window.location.href = '/login';
    }
  </script>
</body>
</html>