<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Farmacia - Sistema de Gestión</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    :root {
      --pink-primary: #e83e8c;
      --pink-dark: #d63384;
      --pink-light: #f8f0f5;
      --pink-badge: #f7d6e6;
      --pink-text: #85144b;
    }
    body {
      background-color: var(--pink-light);
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    .navbar-custom {
      background-color: var(--pink-dark);
    }
    .card-product {
      border: 1px solid #f1d2e1;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .card-product:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 16px rgba(214, 51, 132, 0.15);
    }
    .text-pink-primary {
      color: var(--pink-dark);
    }
    .badge-pink-category {
      background-color: var(--pink-badge);
      color: var(--pink-text);
      font-weight: 600;
    }
    .badge-status {
      background-color: var(--pink-primary);
    }
  </style>
</head>
<body>

  <nav class="navbar navbar-expand-lg navbar-dark navbar-custom shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="#">Farmacia FullStack</a>
    </div>
  </nav>

  <div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 class="fw-bold text-pink-primary">Catálogo de Medicamentos</h2>
      <span class="badge badge-status fs-6">Sistema Activo</span>
    </div>

    <div class="row">
      <% if (productos && productos.length > 0) { %>
        <% productos.forEach(producto => { %>
          <div class="col-md-4 col-lg-3 mb-4">
            <div class="card card-product h-100 shadow-sm border-0">
              <div class="card-body">
                <span class="badge badge-pink-category mb-2"><%= producto.categoria %></span>
                <h5 class="card-title fw-bold text-pink-primary"><%= producto.nombre %></h5>
                <p class="card-text text-muted small"><%= producto.descripcion %></p>
                <div class="d-flex justify-content-between align-items-center mt-3">
                  <span class="fs-5 fw-bold text-pink-primary">S/ <%= Number(producto.precio).toFixed(2) %></span>
                  <span class="badge <%= producto.stock > 0 ? 'bg-secondary' : 'bg-danger' %>">
                    Stock: <%= producto.stock %>
                  </span>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12">
          <div class="alert alert-light text-center border" role="alert">
            No hay productos registrados en la base de datos.
          </div>
        </div>
      <% } %>
    </div>
  </div>

</body>
</html>